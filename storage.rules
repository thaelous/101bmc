rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Reglas de seguridad de almacenamiento para '101 Buenos Malos Consejos'
    // Permite lectura a usuarios autenticados con Google
    
    // 1. Libro Digital en la raíz del Storage (101BMC.pdf)
    match /101BMC.pdf {
      allow read: if request.auth != null;
      allow write: if false; // Solo administración/consola
    }

    match /101bmc.pdf {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 2. Carpeta con los 113 capítulos del audiolibro (101bmc[NUMERO]of113.mp3)
    match /audiolibro/{filename} {
      allow read: if request.auth != null;
      allow write: if false; // Solo administración/consola
    }

    // Cierre por defecto para el resto de archivos
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
