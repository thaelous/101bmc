rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Reglas de seguridad para colección "codigos"
    // Proyecto: 101 Buenos Malos Consejos
    match /codigos/{codigoId} {
      // Permitir leer códigos no canjeados o aquellos pertenecientes al usuario
      allow get: if (resource.data.canjeado == false) ||
        (request.auth != null && (resource.data.usado_por == request.auth.token.email || resource.data.usadoPor == request.auth.token.email));

      // Permitir listar códigos
      allow list: if (resource.data.canjeado == false) ||
        (request.auth != null && (resource.data.usado_por == request.auth.token.email || resource.data.usadoPor == request.auth.token.email));

      // Quema y canje de código
      allow update: if resource.data.canjeado == false &&
        request.resource.data.canjeado == true;

      // Creación y eliminación deshabilitadas para clientes ordinarios (solo consola/admin)
      allow create, delete: if false;
    }

    // Regla de cierre por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
